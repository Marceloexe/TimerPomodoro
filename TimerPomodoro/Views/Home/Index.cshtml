<div class="alert alert-warning alert-dismissible fade show my-2" role="alert" ng-if="mensagemErroPersistencia">
    <strong>⚠️ Erro de Sincronização:</strong> {{ mensagemErroPersistencia }}
</div>

@{
    ViewBag.Title = "Timer Pomodoro";
}

<div class="text-center" style="margin-top: 20px;" ng-controller="timerController">

    <h1 class="display-4">Timer Pomodoro</h1>

    <div class="alert alert-primary d-inline-block px-4 py-2 my-2 shadow-sm" ng-if="tarefaAtiva">
        <small class="text-uppercase fw-bold text-muted d-block">Trabalhando em agora:</small>
        <strong>{{ tarefaAtiva.Titulo }}</strong>
        <span class="badge bg-dark ms-2">🍅 {{ tarefaAtiva.PomodorosConcluidos || 0 }} ciclo(s)</span>
    </div>
    <div class="alert alert-light d-inline-block px-4 py-2 my-2 border" ng-if="!tarefaAtiva">
        <small class="text-muted">Nenhuma tarefa selecionada. Escolha uma abaixo para carregar os seus tempos.</small>
    </div>

    <div style="font-size: 6rem; font-weight: bold;">{{ tempoFormatado }}</div>
    <h3 class="text-muted mb-3">{{ faseAtual }}</h3>

    <div class="d-flex justify-content-center gap-2 my-3">
        <div class="p-3 border rounded shadow-sm" ng-class="faseAtual === 'Foco' ? 'bg-primary text-white' : 'bg-white text-dark'">
            Foco ({{ tempoFocoCustom }}m)
        </div>
        <div class="p-3 border rounded shadow-sm" ng-class="faseAtual === 'Pausa Curta' ? 'bg-warning text-dark' : 'bg-white text-dark'">
            Pausa Curta ({{ pausaCurtaCustom }}m)
        </div>
        <div class="p-3 border rounded shadow-sm" ng-class="faseAtual === 'Pausa Longa' ? 'bg-info text-white' : 'bg-white text-dark'">
            Pausa Longa ({{ pausaLongaCustom }}m)
        </div>
    </div>

    <div class="mb-5">
        <button class="btn btn-dark btn-lg" ng-click="iniciar()">Iniciar</button>
        <button class="btn btn-dark btn-lg" ng-click="pausar()">Pausar</button>
        <button class="btn btn-dark btn-lg" ng-click="resetar()">Resetar</button>
    </div>

    <hr />

    <div class="row text-start mt-4">

        <div class="col-md-5 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">{{ novaTarefa.Id === 0 ? 'Nova Tarefa' : 'Editar Tarefa' }}</h5>
                </div>
                <div class="card-body">
                    <form ng-submit="salvarTarefa()">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Título</label>
                            <input type="text" class="form-control" ng-model="novaTarefa.Titulo" required placeholder="Ex: Estudar C# e Entity Framework">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Descrição</label>
                            <textarea class="form-control" ng-model="novaTarefa.Descricao" rows="2" placeholder="Detalhes da tarefa..."></textarea>
                        </div>

                        <div class="row">
                            <div class="col-4 mb-3">
                                <label class="form-label small fw-bold">Foco (min)</label>
                                <input type="number" class="form-control" min="1" max="120" ng-model="novaTarefa.TempoFoco" required>
                            </div>
                            <div class="col-4 mb-3">
                                <label class="form-label small fw-bold">Pausa (min)</label>
                                <input type="number" class="form-control" min="1" max="60" ng-model="novaTarefa.PausaCurta" required>
                            </div>
                            <div class="col-4 mb-3">
                                <label class="form-label small fw-bold">P. Longa (min)</label>
                                <input type="number" class="form-control" min="1" max="60" ng-model="novaTarefa.PausaLonga" required>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-2">
                            <button type="button" class="btn btn-outline-secondary" ng-click="limparFormulario()" ng-if="novaTarefa.Id !== 0">Cancelar</button>
                            <button type="submit" class="btn btn-success w-100 ms-1">Salvar Tarefa</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Suas Tarefas</h5>
                    <span class="badge bg-secondary">{{ tarefas.length }} cadastrada(s)</span>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center"
                        ng-repeat="t in tarefas track by $index"
                        ng-class="{'table-active': tarefaAtiva.Id === t.Id}">

                        <div>
                            <h6 class="mb-1 fw-bold">{{ t.Titulo }}</h6>
                            <small class="text-muted d-block mb-1" ng-if="t.Descricao">{{ t.Descricao }}</small>

                            <div class="d-flex gap-1 align-items-center">
                                <span class="badge bg-dark">
                                    🍅 {{ t.PomodorosConcluidos || 0 }} ciclo(s)
                                </span>
                                <span class="badge bg-secondary">⏱️ {{ t.TempoFoco }}m / {{ t.PausaCurta }}m / {{ t.PausaLonga }}m</span>
                            </div>
                        </div>

                        <div class="btn-group btn-group-sm">
                            <button class="btn" ng-class="tarefaAtiva.Id === t.Id ? 'btn-success' : 'btn-primary'" ng-click="selecionarTarefa(t)">
                                {{ tarefaAtiva.Id === t.Id ? 'Em Foco' : 'Selecionar' }}
                            </button>
                            <button class="btn btn-outline-secondary" ng-click="editarTarefa(t)">Editar</button>
                            <button class="btn btn-outline-danger" ng-click="deletarTarefa(t.Id)">Excluir</button>
                        </div>
                    </li>
                    <li class="list-group-item text-center text-muted py-4" ng-if="tarefas.length === 0">
                        Nenhuma tarefa criada. Preencha o formulário ao lado para começar.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>