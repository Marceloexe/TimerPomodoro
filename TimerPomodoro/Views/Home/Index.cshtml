@{
    ViewBag.Title = "Home Page";
}
<div class="text-center" style="margin-top: 50px;" ng-app="pomodoroApp" ng-controller="timerController">

    <!-- C# injetando o título (Server-side) -->
    @{ var nomeProjeto = "Timer Pomodoro"; }
    <h1 class="display-4">@nomeProjeto</h1>

    <!-- Angular exibindo o tempo (Client-side) -->
    <div style="font-size: 6rem; font-weight: bold;">{{ tempoFormatado }}</div>
    <h3 class="text-muted">{{ faseAtual }}</h3>

    <!-- HTML com classes CSS do Bootstrap -->
    <div style="margin-top: 30px;">
        <button class="btn btn-success btn-lg" ng-click="iniciar()">Iniciar</button>
        <button class="btn btn-warning btn-lg" ng-click="pausar()">Pausar</button>
        <button class="btn btn-danger btn-lg" ng-click="resetar()">Resetar</button>
    </div>
</div>

<!-- O Razor garante que isso só rode após o Angular ser carregado -->
@section scripts {
    <!-- Aponta para o arquivo baixado via NuGet -->
    <script src="~/Scripts/angular.js"></script>

    <script>
                var app = angular.module('pomodoroApp', []);

                app.controller('timerController', function($scope) {
                    // Configurações fixas exigidas para esta semana
                    var tempoFoco = 25 * 60;

                    $scope.tempoAtual = tempoFoco;
                    $scope.faseAtual = "Foco";
                    $scope.tempoFormatado = "25:00";

                    $scope.iniciar = function() { alert("Você clicou em Iniciar!"); };
                    $scope.pausar = function() { alert("Você clicou em Pausar!"); };
                    $scope.resetar = function() {
                        $scope.tempoAtual = tempoFoco;
                        $scope.tempoFormatado = "25:00";
                    };
                });
    </script>
}