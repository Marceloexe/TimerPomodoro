@{ ViewBag.Title = "Timer"; }
<section class="view active">
    <svg class="blob l" viewBox="0 0 240 190" preserveAspectRatio="none"><path d="M0 40C40 70 70 110 110 160C130 182 150 190 240 190H0Z" fill="var(--blob)" /></svg>
    <svg class="blob r" viewBox="0 0 260 150" preserveAspectRatio="none"><path d="M260 20C200 30 130 70 70 150H260Z" fill="var(--blob)" /></svg>

    <div class="timer-wrap">
        <div class="now">
            <span class="ic"><svg class="i"><use href="#i-briefcase" /></svg></span>
            <div>
                <small>Trabalhando em agora:</small>
                <div class="row"><b id="nowTitle">{{ tarefaAtiva.Titulo || 'Nenhuma tarefa' }}</b><span>🍅 <span id="nowCycles">{{ tarefaAtiva.PomodorosConcluidos || 0 }}</span> ciclo(s)</span></div>
            </div>
        </div>

        <div class="dial">
            <svg class="ring" viewBox="0 0 264 264" width="264" height="264">
                <circle cx="132" cy="132" r="128" fill="none" stroke="var(--ring)" stroke-width="5" />
                <circle id="prog" cx="132" cy="132" r="128" fill="none" stroke="var(--blue)" stroke-width="7" stroke-linecap="round" ng-attr-stroke-dasharray="{{ progressoTimer }} 805" />
            </svg>
            <div class="face">
                <div class="time" id="time">{{ tempoFormatado }}</div>
                <div class="mode" id="modeLabel">{{ faseAtual }}</div>
            </div>
        </div>

        <div class="modes" id="modes">
            <button type="button" ng-click="mudarFase('Foco')" ng-class="{sel: faseAtual === 'Foco'}"><span class="ic"><svg class="i"><use href="#i-target" /></svg></span><span>Foco</span><b id="mFocus">{{ tempoFocoCustom }} min</b></button>
            <button type="button" ng-click="mudarFase('Pausa Curta')" ng-class="{sel: faseAtual === 'Pausa Curta'}"><span class="ic"><svg class="i"><use href="#i-pause" /></svg></span><span>Pausa Curta</span><b id="mShort">{{ pausaCurtaCustom }} min</b></button>
            <button type="button" ng-click="mudarFase('Pausa Longa')" ng-class="{sel: faseAtual === 'Pausa Longa'}"><span class="ic"><svg class="i"><use href="#i-moon" /></svg></span><span>Pausa Longa</span><b id="mLong">{{ pausaLongaCustom }} min</b></button>
        </div>

        <p class="integration-error" role="alert" ng-if="mensagemErroPersistencia">{{ mensagemErroPersistencia }}</p>
        <div class="ctrls">
            <button type="button" class="btn go" id="start" ng-click="iniciar()"><svg class="i"><use href="#i-play" /></svg>Iniciar</button>
            <button type="button" class="btn pause" id="pause" ng-click="pausar()"><svg class="i"><use href="#i-pause-solid" /></svg>Pausar</button>
            <button type="button" class="btn reset" id="reset" ng-click="resetar()"><svg class="i"><use href="#i-refresh" /></svg>Resetar</button>
        </div>
    </div>

    <footer class="plain" style="margin-top:auto;padding-top:44px">© @DateTime.Now.Year - Timer Pomodoro</footer>
</section>
