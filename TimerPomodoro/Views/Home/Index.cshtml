@{
    ViewBag.Title = "Home Page";
}
<div class="text-center" style="margin-top: 50px;" ng-app="pomodoroApp" ng-controller="timerController">

    @{ var nomeProjeto = "Timer Pomodoro"; }
    <h1 class="display-4">@nomeProjeto</h1>

    <div style="font-size: 6rem; font-weight: bold;">{{ tempoFormatado }}</div>
    <h3 class="text-muted" style="margin-bottom: 20px;">{{ faseAtual }}</h3>

    <div style="margin-bottom: 30px;">
        <button class="btn" ng-click="foco()" ng-class="faseAtual === 'Foco' ? 'btn-primary' : 'btn-outline-primary'">
            Foco (25m)
        </button>

        <button class="btn" ng-click="pausaCurta()" ng-class="faseAtual === 'Pausa Curta' ? 'btn-warning' : 'btn-outline-secondary'">
            Pausa Curta (5m)
        </button>

        <button class="btn" ng-click="pausaLonga()" ng-class="faseAtual === 'Pausa Longa' ? 'btn-info' : 'btn-outline-info'">
            Pausa Longa (15m)
        </button>
    </div>

    <div>
        <button class="btn btn-dark btn-lg" ng-click="iniciar()"> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-play-fill" viewBox="0 0 16 16">
        <path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393" />
        </svg> Iniciar</button>

        <button class="btn btn-dark btn-lg" ng-click="pausar()"> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pause" viewBox="0 0 16 16">
        <path d="M6 3.5a.5.5 0 0 1 .5.5v8a.5.5 0 0 1-1 0V4a.5.5 0 0 1 .5-.5m4 0a.5.5 0 0 1 .5.5v8a.5.5 0 0 1-1 0V4a.5.5 0 0 1 .5-.5" />
        </svg> Pausar</button>

        <button class="btn btn-dark btn-lg" ng-click="resetar()"> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-counterclockwise" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z" />
        <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466" />
        </svg> Resetar</button>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/angular.js"></script>
    <script src="~/Scripts/app.js"></script>
}