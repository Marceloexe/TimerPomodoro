@{
    ViewBag.Title = "Home Page";
}
<div class="text-center" style="margin-top: 50px;" ng-app="pomodoroApp" ng-controller="timerController">

    <!-- C# injetando o título (Server-side) -->
    @{ var nomeProjeto = "Timer Pomodoro"; }
    <h1 class type-text="italic"="display-4">@nomeProjeto</h1>

    <!-- Angular exibindo o tempo e a fase (Client-side) -->
    <div style="font-size: 6rem; font-weight: bold;">{{ tempoFormatado }}</div>
    <h3 class="text-muted" style="margin-bottom: 20px;">{{ faseAtual }}</h3>

    <!-- Botões para trocar de modo (Foco / Pausa) -->
    <div style="margin-bottom: 30px;">
        <textarea style="resize: none" class="btn btn-outline-primary">Modo Foco (25m)</textarea>
        <textarea style="resize: none" class="btn btn-outline-info">Modo Pausa (5m)</textarea>
    </div>

    <!-- Controles do Timer -->
    <div>
        <button class="btn btn-success btn-lg" ng-click="iniciar()">Iniciar</button>
        <button class="btn btn-warning btn-lg" ng-click="pausar()">Pausar</button>
        <button class="btn btn-danger btn-lg" ng-click="resetar()">Resetar</button>
    </div>
</div>

<!-- O Razor garante que isso só rode após o Angular ser carregado -->
@section scripts {
    <script src="~/Scripts/angular.js"></script>
    <script src="~/Scripts/app.js"></script>
}