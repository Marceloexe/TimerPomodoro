@{ ViewBag.Title = "Tarefas"; }
<section class="view active">
    <div class="tasks-wrap">

        <div class="card">
            <div class="hd"><h2><svg class="i"><use href="#i-list-plus" /></svg>{{ novaTarefa.Id === 0 ? 'Nova Tarefa' : 'Editar Tarefa' }}</h2></div>

            <form class="form" ng-submit="salvarTarefa()">
                <label for="Titulo">Título</label>
                <div class="field"><svg class="i"><use href="#i-file" /></svg><input id="Titulo" name="Titulo" ng-model="novaTarefa.Titulo" placeholder="Ex: Estudar, Trabalhar..." required /></div>

                <label for="Descricao">Descrição</label>
                <div class="field"><svg class="i"><use href="#i-file" /></svg><textarea id="Descricao" name="Descricao" ng-model="novaTarefa.Descricao" placeholder="Detalhes da tarefa..."></textarea></div>

                <div class="trio">
                    <div><label for="Foco">Foco (min)</label><div class="field"><svg class="i"><use href="#i-target" /></svg><input id="Foco" name="TempoFoco" ng-model="novaTarefa.TempoFoco" type="number" min="1" required max="60" /></div></div>
                    <div><label for="PausaCurta">Pausa (min)</label><div class="field"><svg class="i"><use href="#i-pause" /></svg><input id="PausaCurta" name="PausaCurta" ng-model="novaTarefa.PausaCurta" type="number" min="1" required max="60" /></div></div>
                    <div><label for="PausaLonga">P. Longa (min)</label><div class="field"><svg class="i"><use href="#i-moon" /></svg><input id="PausaLonga" name="PausaLonga" ng-model="novaTarefa.PausaLonga" type="number" min="1" required max="60" /></div></div>
                </div>

                <button class="save" type="submit"><svg class="i"><use href="#i-plus-circle" /></svg>Salvar</button>
                <button class="task-action" type="button" ng-if="novaTarefa.Id" ng-click="limparFormulario()">Cancelar edição</button>
            </form>
        </div>

        <div class="card">
            <div class="hd"><h2><svg class="i"><use href="#i-list" /></svg>Suas Tarefas</h2><span class="badge">{{ tarefas.length }} cadastrada(s)</span></div>
            <div class="sep"></div>

            <div class="empty" ng-if="tarefas.length === 0">
                <div class="circle"><svg class="i"><use href="#i-clipboard" /></svg></div>
                <strong>Nenhuma tarefa criada.</strong><p>Preencha o formulário ao lado para começar.</p>
            </div>
            <ul class="list" ng-if="tarefas.length">
                <li ng-repeat="t in tarefas track by t.Id">
                    <div>
                        <b>{{ t.Titulo }}</b><small class="t-meta">{{ t.Descricao }}</small>
                        <small class="t-meta">{{ t.TempoFoco }} / {{ t.PausaCurta }} / {{ t.PausaLonga }} min · 🍅 {{ t.PomodorosConcluidos || 0 }} ciclo(s)</small>
                        <div class="task-actions">
                            <button type="button" class="task-action" ng-click="selecionarETimer(t, '@Url.Action("Index", "Home")')">Selecionar e ir ao timer</button>
                            <button type="button" class="task-action" ng-click="editarTarefa(t)">Editar</button>
                            <button type="button" class="task-action danger" ng-click="deletarTarefa(t.Id)">Excluir</button>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <footer class="line">© @DateTime.Now.Year - Timer Pomodoro</footer>
</section>
